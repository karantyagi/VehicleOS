{
  "name": "vehicleos",
  "private": true,
  "version": "0.1.0",
  "description": "VehicleOS monorepo",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dogfood:load-karan-tlx": "pnpm --filter @vehicleos/api exec tsx ../../seeds/dogfood/karan-tlx/load-seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  }
}
