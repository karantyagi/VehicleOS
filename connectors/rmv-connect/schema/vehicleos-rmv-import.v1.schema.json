{
  "$id": "https://vehicleos.app/schema/vehicleos-rmv-import.v1.json",
  "title": "VehicleOsRmvImportV1",
  "type": "object",
  "required": ["version", "vehicle", "records", "source", "exportedAt"],
  "properties": {
    "version": { "const": "1" },
    "source": {
      "type": "string",
      "description": "Importer identifier, e.g. rmv-pdf-manual"
    },
    "exportedAt": { "type": "string", "format": "date-time" },
    "vehicle": {
      "type": "object",
      "required": ["vin", "year", "make", "model"],
      "properties": {
        "vin": { "type": "string", "minLength": 5 },
        "year": { "type": "integer", "minimum": 1980, "maximum": 2100 },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "trim": { "type": "string" },
        "currentMileage": { "type": "integer", "minimum": 0 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agency", "recordDate", "eventType", "description", "details"],
        "properties": {
          "agency": { "type": "string" },
          "recordDate": { "type": "string", "format": "date" },
          "mileage": { "type": ["integer", "null"], "minimum": 0 },
          "eventType": {
            "type": "string",
            "enum": ["registration", "title", "inspection", "license", "lien", "other"]
          },
          "description": { "type": "string" },
          "details": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    }
  }
}
