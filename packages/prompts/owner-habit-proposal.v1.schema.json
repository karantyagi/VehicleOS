{
  "$id": "https://vehicleos.app/schema/owner-habit-proposal.v1.json",
  "title": "OwnerHabitProposalV1",
  "description": "Structured, owner-reviewable output shared by deterministic extraction and future LLM extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "entryId",
    "serviceName",
    "intervalMiles",
    "intervalMonths",
    "basis",
    "captureChannel",
    "extractionMethod",
    "sourceText",
    "confidence"
  ],
  "properties": {
    "version": { "const": "1" },
    "entryId": { "type": "string", "pattern": "^owner-habit:" },
    "serviceName": { "type": "string", "minLength": 1 },
    "intervalMiles": { "type": ["integer", "null"], "minimum": 250, "maximum": 100000 },
    "intervalMonths": { "type": ["integer", "null"], "minimum": 1, "maximum": 60 },
    "basis": { "enum": ["mileage", "time", "mixed"] },
    "captureChannel": { "enum": ["voice", "text"] },
    "extractionMethod": { "enum": ["rules", "llm"] },
    "sourceText": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "anyOf": [
    { "properties": { "intervalMiles": { "type": "integer" } } },
    { "properties": { "intervalMonths": { "type": "integer" } } }
  ]
}
