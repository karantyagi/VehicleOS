{
  "$id": "https://vehicleos.app/schema/service-alias-bundle.v1.json",
  "type": "object",
  "required": ["bundleId", "version", "aliases"],
  "additionalProperties": false,
  "properties": {
    "bundleId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "oemFamily": { "type": "string" },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["canonicalServiceId", "phrase", "matchKind", "priority", "source"],
        "additionalProperties": false,
        "properties": {
          "canonicalServiceId": { "type": "string" },
          "phrase": { "type": "string" },
          "matchKind": { "type": "string", "enum": ["exact", "contains", "regex"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 999 },
          "source": { "type": "string", "enum": ["creator", "dogfood", "owner_confirmed"] }
        }
      }
    }
  }
}
