{
  "name": "@vehicleos/knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node --import tsx/esm src/cli/validate-catalog.ts",
    "generate:tier1": "node --import tsx/esm src/cli/generate-tier1-packs.ts",
    "generate:tier1:missing": "node --import tsx/esm src/cli/generate-tier1-packs.ts --skip-existing",
    "build:tier2000:pdf-overrides": "node --import tsx/esm src/cli/build-tier2000-pdf-overrides.ts",
    "generate:tier2000": "node --import tsx/esm src/cli/build-tier2000-pdf-overrides.ts && node --import tsx/esm src/cli/generate-tier2000-packs.ts",
    "generate:tier2000:missing": "node --import tsx/esm src/cli/generate-tier2000-packs.ts --skip-existing",
    "verify:oem": "node --import tsx/esm src/cli/verify-oem-packs.ts --all",
    "verify:oem:pack": "node --import tsx/esm src/cli/verify-oem-packs.ts",
    "verify:tier2000": "node --import tsx/esm src/cli/verify-tier2000-batch.ts --tier2-bc --skip-verified --promote --concurrency=4",
    "verify:tier2000:retry-blocked": "node --import tsx/esm src/cli/verify-tier2000-batch.ts --skip-verified --promote --concurrency=4 --pack-list=/tmp/tier2000-blocked-pack-ids.txt",
    "demote:scaffolds": "node --import tsx/esm src/cli/demote-scaffold-auto-verified.ts",
    "sync:catalog": "node --import tsx/esm src/cli/sync-catalog-qa.ts"
  },
  "dependencies": {
    "@vehicleos/domain": "workspace:*",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "@types/pdf-parse": "1.1.4",
    "@types/node": "^22.7.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
